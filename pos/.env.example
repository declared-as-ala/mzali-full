# Copy to pos/.env.local for local dev. In production these are set
# directly in the `pos` service's environment block in
# deploy/docker-compose.prod.yml (fed from deploy/.env) — this file is only
# a reference/local-dev template.

NODE_ENV=development
PORT=3001

# Internal BFF target — the browser never calls this directly.
# Local dev: point at the backend running on your host.
# Production: http://api:4000 (internal Docker network).
MZALI_API_URL=http://localhost:4000

# Must match the backend's SERVICE_TOKEN exactly.
MZALI_SERVICE_TOKEN=change-me-at-least-32-characters-long!!

# Must match the backend's JWT_ACCESS_SECRET exactly — POS verifies access
# tokens locally before deciding whether to refresh them.
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long!!

# Set to "false" only for local HTTP dev; must be unset/true in production.
COOKIE_SECURE=false
