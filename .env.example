
# ===========================================
# PHASE 1 — WooCommerce as temporary backend
# ===========================================
# Generate keys at:
# https://ahmedmzaliboutique.com/wp-admin/admin.php?page=wc-settings&tab=advanced&section=keys
WC_API_URL=https://ahmedmzaliboutique.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default status for new storefront orders (Tunisian COD workflow slug)
WC_DEFAULT_ORDER_STATUS=en-attente

# ===========================================
# Public site config
# ===========================================
NEXT_PUBLIC_SITE_NAME=Boutique Ahmed Mzali
NEXT_PUBLIC_SITE_URL=https://ahmedmzaliboutique.com
NEXT_PUBLIC_CURRENCY_CODE=TND
NEXT_PUBLIC_CURRENCY_SYMBOL=DT

# ===========================================
# Navex shipping API — https://navex.tn
# ===========================================
NAVEX_API_BASE=https://app.navex.tn
NAVEX_TOKEN_ADD=
NAVEX_TOKEN_GET=
NAVEX_TOKEN_DELETE=
# Orders are auto-pushed to Navex when delivery company contains this string (case-insensitive)
NAVEX_AUTO_PUSH_LABEL=navex

# ===========================================
# First Delivery Group API — https://www.firstdeliverygroup.com
# ===========================================
FIRST_DELIVERY_API_BASE=https://www.firstdeliverygroup.com/api/v2
FIRST_DELIVERY_TOKEN=
# Auto-push when delivery company name contains this string (case-insensitive)
FIRST_DELIVERY_AUTO_PUSH_LABEL=firstdelivery


# ===========================================
# Axess Logistique API
# ===========================================
AXESS_API_BASE=
AXESS_TOKEN=
# AXESS_ENTREPOT_ID=
AXESS_SOURCE_NOM=
AXESS_SOURCE_TEL=
AXESS_SOURCE_ADDRESS=
AXESS_SOURCE_GOV=
AXESS_SOURCE_DELEGATION=
AXESS_SOURCE_LOCALITE=

# ===========================================
# Admin auth
# ===========================================
ADMIN_PASSWORD=change-me

# WordPress application password — for image uploads to /wp-json/wp/v2/media.
# Generate at /wp-admin/profile.php → Mots de passe d'application
WP_ADMIN_USER=
WP_APP_PASSWORD=
SESSION_SECRET=change-me-32-bytes-min

# ===========================================
# Phase 2 — Mzali NestJS API backend
# ===========================================
# Which backend powers the storefront: "woocommerce" (legacy) or "mzali-api".
# The flag exists for safe cutover and rollback; final value is mzali-api.
COMMERCE_PROVIDER=woocommerce
# Same value, exposed to the browser (build-time inlined) so client components
# like the checkout page know whether to show mzali-api-only UI (coupon field).
# Not a secret — just a config flag. Keep in sync with COMMERCE_PROVIDER above.
NEXT_PUBLIC_COMMERCE_PROVIDER=woocommerce
# Internal URL of the NestJS API (private Docker network in production)
# MZALI_API_URL=http://api:4000
# Shared secret for server-to-server storefront reads / order creation
# MZALI_SERVICE_TOKEN=
# HS256 secret shared with the API for verifying access-token cookies locally
# JWT_ACCESS_SECRET=
# Keep true/omitted behind HTTPS. Root docker-compose.yml overrides this to
# false only for plain-http localhost development.
COOKIE_SECURE=true
