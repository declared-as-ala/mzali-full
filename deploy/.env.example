# Copy to deploy/.env on the VPS and replace every change-me value:
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env && nano deploy/.env
# Keep this file non-secret; deploy/.env is ignored by git (deploy/.gitignore).
# This IS the production env file (docs/deployment call it .env.production —
# same file, this is where it actually lives so docker compose --env-file
# deploy/.env picks it up automatically).

# Images
GHCR_OWNER=declared-as-ala
IMAGE_TAG=replace-with-a-git-sha
COMPOSE_PROJECT_NAME=mzali

# Public routing — all six must resolve in DNS before first `caddy up`
# (see docs/deployment/ovh-dns.md). Admin has no separate app; it redirects
# to STOREFRONT_DOMAIN/admin — see docs/deployment/ovh-production-audit.md §6.
STOREFRONT_DOMAIN=ahmedmzaliboutique.tn
WWW_DOMAIN=www.ahmedmzaliboutique.tn
ADMIN_DOMAIN=admin.ahmedmzaliboutique.tn
POS_DOMAIN=pos.ahmedmzaliboutique.tn
API_DOMAIN=api.ahmedmzaliboutique.tn
MEDIA_DOMAIN=media.ahmedmzaliboutique.tn
MINIO_PUBLIC_URL=https://media.ahmedmzaliboutique.tn
CADDY_ACME_EMAIL=ops@ahmedmzaliboutique.tn
NEXT_PUBLIC_SITE_NAME="Boutique Ahmed Mzali"
NEXT_PUBLIC_SITE_URL=https://ahmedmzaliboutique.tn
NEXT_PUBLIC_CURRENCY_CODE=TND
NEXT_PUBLIC_CURRENCY_SYMBOL=DT

# Storefront/BFF
COMMERCE_PROVIDER=mzali-api
SESSION_SECRET=change-me-generate-64-hex-characters
JWT_ACCESS_SECRET=change-me-generate-64-hex-characters
SERVICE_TOKEN=change-me-generate-64-hex-characters

# API — off by default. No app in this system calls the API's public domain
# directly (storefront and POS both use the internal Docker network), so
# leave this empty unless you have a specific reason to allow direct browser
# calls to api.ahmedmzaliboutique.tn. If you do set it, comma-separate the
# exact origins (no wildcards, no trailing slash):
# CORS_ORIGINS=https://ahmedmzaliboutique.tn,https://www.ahmedmzaliboutique.tn,https://admin.ahmedmzaliboutique.tn,https://pos.ahmedmzaliboutique.tn
CORS_ORIGINS=

# MongoDB replica set authentication
MONGO_INITDB_ROOT_USERNAME=mzali_root
MONGO_INITDB_ROOT_PASSWORD=change-me-url-safe-password
# Shared replica-set key: generate with `openssl rand -base64 756`.
MONGO_REPLICA_KEY=QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFB
# URL-encode the password if it contains reserved URI characters.
MONGODB_URI="mongodb://mzali_root:change-me-url-safe-password@mongo:27017/mzali?replicaSet=rs0&authSource=admin"

# Redis
REDIS_PASSWORD=change-me-url-safe-password
REDIS_URL=redis://:change-me-url-safe-password@redis:6379

# MinIO
MINIO_ROOT_USER=mzali_minio
MINIO_ROOT_PASSWORD=change-me-long-random-password

# Backend behavior
ACCESS_TOKEN_TTL_SECONDS=900
# Rolling session lifetime, shared by the backend (real source of truth —
# Session documents) and every frontend's cookie maxAge hint (storefront,
# pos). Every successful token refresh re-issues this far out again, so an
# actively-used session never actually expires — this only kicks in after
# genuine inactivity. 30-90 days is reasonable; avoid setting this to
# something that reads as effectively permanent (years).
REFRESH_TOKEN_TTL_DAYS=30
STRICT_STOCK=false

# Set to true ONLY during pre-DNS bring-up (first deploy, before the domains
# resolve here) — deploy.sh skips the domain-based HTTPS smoke tests, since
# they can't pass without DNS/TLS. Container-internal health checks still
# run. Unset/remove this once DNS is live and never leave it set in
# steady-state production — it would hide a real Caddy/DNS/TLS regression.
SKIP_DOMAIN_SMOKE_TESTS=false

# Carrier integrations (optional; leave empty when unused)
NAVEX_API_BASE=https://app.navex.tn
NAVEX_TOKEN_ADD=
NAVEX_TOKEN_GET=
NAVEX_TOKEN_DELETE=
NAVEX_AUTO_PUSH_LABEL=navex
FIRST_DELIVERY_API_BASE=https://www.firstdeliverygroup.com/api/v2
FIRST_DELIVERY_TOKEN=
FIRST_DELIVERY_AUTO_PUSH_LABEL=firstdelivery
AXESS_API_BASE=
AXESS_TOKEN=
AXESS_ENTREPOT_ID=
AXESS_SOURCE_NOM=
AXESS_SOURCE_TEL=
AXESS_SOURCE_ADDRESS=
AXESS_SOURCE_GOV=
AXESS_SOURCE_DELEGATION=
AXESS_SOURCE_LOCALITE=

# Backup/restore
BACKUP_TARGET=/opt/mzali/backups
BACKUP_RETENTION_DAYS=14
# Required by restore-mongodb.sh; intentionally has no default.
RESTORE_MONGODB_URI=
# Optional — verify-production.sh resolves a real published product's slug
# from the live catalog API on its own when this is left unset (or left at
# this placeholder). Only set it if you want to pin the smoke test to one
# specific product instead.
SMOKE_PRODUCT_PATH=
