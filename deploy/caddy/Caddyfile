{
	email {$CADDY_ACME_EMAIL}
	# Ops-visible only on the loopback inside the container (used by this
	# compose file's own caddy healthcheck) — never published externally.
	admin 127.0.0.1:2019
}

# Shared security headers — applied on every public site block below.
# No inline snippet reuse across files, so this is duplicated per block
# deliberately (Caddyfile snippets can't span files without an import).
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

{$WWW_DOMAIN} {
	redir https://{$STOREFRONT_DOMAIN}{uri} permanent
}

{$STOREFRONT_DOMAIN} {
	import security_headers
	encode zstd gzip
	# Product/media uploads go through the admin API, not this route, but
	# keep a sane ceiling on anything posted straight to Next.js server actions.
	request_body {
		max_size 25MB
	}
	reverse_proxy storefront:3000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 60s
			dial_timeout 5s
		}
	}
}

# Admin has no separate app/container — it's `/admin/*` inside the
# storefront build (see docs/deployment/ovh-production-audit.md §6).
# middleware.ts in the storefront app rewrites requests here (based on the
# Host header) to the underlying /admin/* routes, so the URL bar shows a
# clean admin.<domain> path with no /admin prefix. Session cookies are
# host-only (no Domain attribute) but that's fine here — login and every
# subsequent request both happen on this same origin.
{$ADMIN_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy storefront:3000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 60s
			dial_timeout 5s
		}
	}
}

{$POS_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	# /api/events is a long-lived SSE stream (inventory/live updates) proxied
	# by the POS app itself — disable response buffering so chunks flush
	# immediately instead of queuing behind Caddy's default buffer.
	@sse path /api/events
	handle @sse {
		reverse_proxy pos:3001 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}
	handle {
		reverse_proxy pos:3001 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 60s
				dial_timeout 5s
			}
		}
	}
}

# Public per your explicit domain list. Nothing in this system requires it —
# both the storefront and POS reach the API over the internal Docker network
# only (see the audit, §7) — so this exists for direct API access/testing,
# not because any app depends on it. CORS stays off unless CORS_ORIGINS is
# set in deploy/.env.
{$API_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy api:4000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 120s
			dial_timeout 5s
		}
	}
}

{$MEDIA_DOMAIN} {
	import security_headers
	# Matches exactly the buckets minio-init grants anonymous download to
	# (see deploy/docker-compose.yml's minio-init command) — avatars/
	# documents/exports/temp stay private; MinIO itself would 403 them even
	# if routed here, but the allow-list should say what's actually public.
	@allowed {
		method GET HEAD
		path /catalog/* /categories/* /banners/*
	}

	handle @allowed {
		reverse_proxy minio:9000
	}

	respond "Not found" 404
}
