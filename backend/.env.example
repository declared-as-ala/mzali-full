# ===========================================
# APP
# ===========================================
NODE_ENV=development
PORT=4000

# ===========================================
# MONGODB (must be a replica-set member — transactions required)
# ===========================================
# Dev (compose maps mongo to localhost): single-node replica set rs0
MONGODB_URI=mongodb://localhost:27017/mzali?directConnection=true

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# MINIO
# ===========================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=mzali-dev
MINIO_SECRET_KEY=change-me-minio-secret
# Public base URL media is served from (reverse proxy / CDN in production)
MINIO_PUBLIC_URL=http://localhost:9000

# ===========================================
# AUTH
# ===========================================
# openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long!!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=3650
# Shared secret presented by the Next BFF on storefront endpoints
SERVICE_TOKEN=change-me-at-least-32-characters-long!!

# ===========================================
# COMMERCE
# ===========================================
# false: insufficient stock flags the order instead of rejecting it (COD reality)
STRICT_STOCK=false
# Internal Docker-network base URL of the storefront (worker -> revalidation route)
STOREFRONT_URL=http://storefront:3000

# ===========================================
# OBSERVABILITY / DOCS
# ===========================================
SWAGGER_ENABLED=true

# ===========================================
# CARRIERS (same names as the storefront's .env — server-side only)
# ===========================================
NAVEX_API_BASE=https://app.navex.tn
NAVEX_TOKEN_ADD=
NAVEX_TOKEN_GET=
NAVEX_TOKEN_DELETE=
NAVEX_AUTO_PUSH_LABEL=navex
FIRST_DELIVERY_API_BASE=https://www.firstdeliverygroup.com/api/v2
FIRST_DELIVERY_TOKEN=
FIRST_DELIVERY_AUTO_PUSH_LABEL=firstdelivery
AXESS_API_BASE=
AXESS_TOKEN=
# AXESS_ENTREPOT_ID=
AXESS_SOURCE_NOM=
AXESS_SOURCE_TEL=
AXESS_SOURCE_ADDRESS=
AXESS_SOURCE_GOV=
AXESS_SOURCE_DELEGATION=
AXESS_SOURCE_LOCALITE=

# ===========================================
# WOOCOMMERCE_MIGRATION (read-only source; only migrate:* commands use these)
# ===========================================
WOO_API_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
