{
  "name": "mzali-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mzali Boutique commerce backend — NestJS API + worker (modular monolith)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker-main.js",
    "start:worker:dev": "nest start --watch --entryFile worker-main",
    "cli": "node dist/cli.js",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "seed:dev": "ts-node -r tsconfig-paths/register scripts/seed-dev.ts",
    "check:contracts": "node scripts/check-contracts.mjs",
    "migration:dry-run": "node dist/cli.js migrate:all --dry-run",
    "migration:run": "node dist/cli.js migrate:all",
    "migration:verify": "node dist/cli.js migrate:verify"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@types/pdfkit": "^0.17.6",
    "archiver": "^8.0.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.0",
    "mongoose": "^8.9.0",
    "nest-commander": "^3.15.0",
    "nestjs-pino": "^4.2.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "jsqr": "^1.4.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0"
  }
}
